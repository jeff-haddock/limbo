# ~/.zshrc → symlink to limbo/zsh/zshrc. Edit here, then `restart`.
# Machine-level shell only; Virgil's layer is sourced at the bottom from its own repo.

export PATH="$HOME/.local/bin:$PATH"

# zoxide: `z <partial>` jumps to frequent dirs. Guarded so the shell works before brew bundle.
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# restart: swap this shell for a fresh login shell (picks up .zshrc edits). From the old Mac.
alias restart='exec zsh -l'

# nvm (Node). Installed by its own script, not brew; see SETUP.md.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Virgil shell layer (tracked in the Virgil repo)
[ -f "$HOME/work/projects/infra/virgil/shell/virgil.zsh" ] && source "$HOME/work/projects/infra/virgil/shell/virgil.zsh"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/Users/jeffhaddock/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/Users/jeffhaddock/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/Users/jeffhaddock/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/Users/jeffhaddock/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/jeffhaddock/.docker/completions $fpath)
autoload -Uz compinit
(( ${+_comps[docker]} )) || compinit
# End of Docker CLI completions
